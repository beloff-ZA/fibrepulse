{
  "name": "fibrepulse",
  "version": "0.1.0",
  "private": true,
  "description": "South African fibre and infrastructure outage intelligence platform.",
  "type": "module",
  "scripts": {
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:topology-api": "tsx apps/api/src/topologyServer.ts",
    "dev:bgp": "tsx services/bgp-monitor/src/index.ts",
    "db:migrate": "tsx packages/db/src/migrate.ts && tsx packages/db/src/migrateTopology.ts && tsx packages/db/src/migrateEvidence.ts",
    "db:migrate:core": "tsx packages/db/src/migrate.ts",
    "db:migrate:topology": "tsx packages/db/src/migrateTopology.ts",
    "db:migrate:evidence": "tsx packages/db/src/migrateEvidence.ts",
    "db:seed": "tsx packages/db/src/seed.ts",
    "db:seed:topology": "tsx packages/db/src/seedTopology.ts",
    "topology:import": "tsx scripts/topologyImport.ts",
    "topology:review": "tsx scripts/reviewTopology.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "fno:import": "tsx services/bgp-monitor/src/importFnoRegistry.ts",
    "fno:discover": "tsx services/bgp-monitor/src/discoverFnoPrefixes.ts",
    "fno:prefixes:import": "tsx services/bgp-monitor/src/importFnoPrefixes.ts"
  },
  "workspaces": ["apps/*", "services/*", "packages/*"],
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^8.2.0",
    "ipaddr.js": "^2.4.0",
    "morgan": "^1.11.0",
    "node-cron": "^4.5.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "main": "index.js",
  "directories": {"doc": "docs"},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "allowScripts": {"esbuild@0.28.1": true}
}
