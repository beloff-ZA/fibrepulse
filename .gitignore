cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Environment files
.env
.env.*
!.env.example

# Build output
dist/
build/
coverage/
.vite/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.swp
*.swo

# Local database/data files
*.sqlite
*.sqlite3
data/

# Certificates and secrets
*.pem
*.key
*.crt
*.p12
*.pfx
EOF
